# Optional for local dev. Without these, progress is saved to ./data.
# On Vercel, connecting Upstash Redis from Storage sets <prefix>KV_REST_API_URL / <prefix>KV_REST_API_TOKEN
# (e.g. scorm_test_KV_REST_API_URL) — any prefix is detected automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
